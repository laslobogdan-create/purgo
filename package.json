{
  "name": "purgo",
  "version": "1.0.1",
  "description": "Purgo — a modern uninstaller for Windows: removes programs and their leftovers.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "keywords": [],
  "author": "Vasili Zaitev",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "pe-library": "^2.0.1",
    "resedit": "^2.0.3"
  },
  "productName": "Purgo",
  "build": {
    "appId": "ro.purgo.uninstaller",
    "productName": "Purgo",
    "copyright": "Copyright © 2026 Vasili Zaitev",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "afterPack": "dev/afterPack.js",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Purgo-${version}-Portable.exe",
      "requestExecutionLevel": "admin"
    },
    "publish": null
  },
  "homepage": "https://github.com/laslobogdan-create/purgo",
  "repository": {
    "type": "git",
    "url": "https://github.com/laslobogdan-create/purgo.git"
  }
}